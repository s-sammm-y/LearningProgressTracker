
@model LearningTracker.Web.ViewModels.CreateActivityViewModel

@{
    ViewData["Title"] = "Add Activity";
}

<div class="container mt-4 activity-create-page">

    <!-- Page Header -->
    <div class="activity-create-header mb-4">
        <div>
            <span class="activity-create-eyebrow">ACTIVITY MANAGEMENT</span>

            <h2 class="activity-create-title">Add Learning Activity</h2>

            <p class="activity-create-description">
                Create a new activity for candidates.
            </p>

            <!-- CSV Actions -->
            <div class="activity-header-actions">

                <!-- Download CSV Template -->
                <a asp-controller="Activities"
                   asp-action="DownloadTemplate"
                   class="activity-template-button">
                    <i class="bi bi-file-earmark-arrow-down"></i>
                    Download CSV Template
                </a>

                <!-- Import CSV Form -->
                <form asp-controller="Activities"
                      asp-action="ImportCsv"
                      method="post"
                      enctype="multipart/form-data"
                      class="activity-import-form">

                    @Html.AntiForgeryToken()

                    <input type="file"
                           id="activityCsvFile"
                           name="file"
                           accept=".csv,text/csv"
                           class="activity-import-input"
                           required />

                    <button type="submit"
                            class="activity-import-button">
                        <i class="bi bi-upload"></i>
                        Import Activities
                    </button>

                </form>

            </div>
        </div>
    </div>

    <!-- Import Error Message -->
    @if (TempData["ImportErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-4"
             style="white-space: pre-line;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ImportErrorMessage"]
        </div>
    }

    <!-- Import Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Create Activity Form -->
    <div class="activity-create-card">

        <div class="activity-create-card-header">
            <h4>Activity Information</h4>
            <p>Enter the details of the learning activity below.</p>
        </div>

        <div class="activity-create-card-body">

            <form asp-controller="Activities"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="activity-validation-summary mb-3">
                </div>

                <!-- Activity Title -->
                <div class="activity-form-group">
                    <label asp-for="Title" class="activity-form-label">
                        Activity Title
                    </label>

                    <input asp-for="Title"
                           class="form-control activity-form-control"
                           placeholder="e.g. Java Fundamentals" />

                    <span asp-validation-for="Title"
                          class="text-danger activity-validation-message">
                    </span>
                </div>

                <!-- Topic -->
                <div class="activity-form-group">
                    <label asp-for="Topic" class="activity-form-label">
                        Topic
                    </label>

                    <input asp-for="Topic"
                           class="form-control activity-form-control"
                           placeholder="e.g. Programming" />

                    <span asp-validation-for="Topic"
                          class="text-danger activity-validation-message">
                    </span>
                </div>

                <!-- Planned Hours -->
                <div class="activity-form-group">
                    <label asp-for="PlannedHours" class="activity-form-label">
                        Planned Hours
                    </label>

                    <input asp-for="PlannedHours"
                           class="form-control activity-form-control"
                           type="number"
                           step="0.01"
                           min="0.01"
                           placeholder="e.g. 20" />

                    <span asp-validation-for="PlannedHours"
                          class="text-danger activity-validation-message">
                    </span>
                </div>

                <!-- Form Actions -->
                <div class="activity-form-actions">

                    <button type="submit"
                            class="activity-create-button">
                        <i class="bi bi-plus-circle"></i>
                        Create Activity
                    </button>

                    <a asp-controller="Activities"
                       asp-action="Index"
                       class="activity-cancel-button">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/activities-create.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
