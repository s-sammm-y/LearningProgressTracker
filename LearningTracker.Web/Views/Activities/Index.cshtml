
@model List<LearningTracker.Models.Entities.Activity>

@{
    ViewData["Title"] = "Activities";
}

<div class="activities-page">
    <div class="container py-5">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="activities-alert alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }

        <!-- Page Header -->
        <div class="activities-header">

            <div>
                <span class="activities-eyebrow">Learning Management</span>

                <h2 class="activities-title">Learning Activities</h2>

                <p class="activities-description">
                    Manage learning activities, topics and planned training hours.
                </p>
            </div>

            <a asp-controller="Activities"
               asp-action="Create"
               class="activities-primary-button">

                <i class="bi bi-plus-circle"></i>
                Add Activity

            </a>

        </div>

        <!-- Activities Content -->
        @if (!Model.Any())
        {
            <div class="activities-empty-state">

                <div class="activities-empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h3>No Activities Yet</h3>

                <p>
                    You haven't created any learning activities.
                    Start by adding your first activity.
                </p>

                <a asp-controller="Activities"
                   asp-action="Create"
                   class="activities-primary-button">

                    <i class="bi bi-plus-circle"></i>
                    Create First Activity

                </a>

            </div>
        }
        else
        {
            <div class="activities-table-card">
                <!-- Table Header -->
                <div class="activities-table-heading">

                    <div>
                        <h4>Available Activities</h4>
                        <p>View and manage all learning activities.</p>
                    </div>

                    <div class="activities-table-tools">

                        <!-- Export CSV -->
                        <a asp-controller="Activities"
                        asp-action="ExportCsv"
                        class="activities-export-button">

                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            Export CSV

                        </a>

                        <!-- Search -->
                        <div class="activities-search">

                            <i class="bi bi-search"></i>

                            <input type="search"
                                id="activitySearch"
                                placeholder="Search activities..."
                                aria-label="Search activities" />

                            <button type="button"
                                    id="clearActivitySearch"
                                    aria-label="Clear search"
                                    hidden>
                                <i class="bi bi-x-lg"></i>
                            </button>

                        </div>

                        <!-- Activity Count -->
                        <span class="activities-count" id="activityCount">
                            @Model.Count @(Model.Count == 1 ? "Activity" : "Activities")
                        </span>

                    </div>

                </div>

                <!-- Scrollable Activities Table -->
                <div class="table-responsive activities-table-scroll">

                    <table class="activities-table">

                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Topic</th>
                                <th>Planned Hours</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var activity in Model)
                            {
                                <tr class="activity-row"
                                    data-search="@($"{activity.Title} {activity.Topic}")">

                                    <td>
                                        <span class="activity-title">
                                            @activity.Title
                                        </span>
                                    </td>

                                    <td>
                                        <span class="activity-topic">
                                            @activity.Topic
                                        </span>
                                    </td>

                                    <td>
                                        <span class="activity-hours">
                                            @activity.PlannedHours.ToString("0.00")
                                            <small>hrs</small>
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Activities"
                                           asp-action="Edit"
                                           asp-route-id="@activity.Id"
                                           class="activities-edit-button">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit

                                        </a>
                                    </td>

                                </tr>
                            }

                            <!-- No Search Results -->
                            <tr id="activityNoResults" hidden>
                                <td colspan="4" class="activity-no-results">
                                    <i class="bi bi-search"></i>
                                    No activities match your search.
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>
        }

        <!-- Back Navigation -->
        <div class="activities-back">
            <a asp-controller="Dashboard"
               asp-action="Index">

                <i class="bi bi-arrow-left"></i>
                Back to Dashboard

            </a>
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/activities.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/activities.js"
            asp-append-version="true"></script>
}
