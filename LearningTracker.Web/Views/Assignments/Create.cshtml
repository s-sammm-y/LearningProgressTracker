@model LearningTracker.Web.ViewModels.AssignActivityViewModel

@{
    ViewData["Title"] = "Assign Activity";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Assign Learning Activity</h2>
        <p class="text-muted">
            Assign an existing learning activity to a candidate.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-controller="Assignments"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="LearnerId"
                           class="form-label">
                        Select Candidate
                    </label>

                    <select asp-for="LearnerId"
                            asp-items="Model.Learners"
                            class="form-select">
                        <option value="">-- Select Candidate --</option>
                    </select>

                    <span asp-validation-for="LearnerId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="ActivityId"
                           class="form-label">
                        Select Learning Activity
                    </label>

                    <select asp-for="ActivityId"
                            asp-items="Model.Activities"
                            class="form-select">
                        <option value="">-- Select Activity --</option>
                    </select>

                    <span asp-validation-for="ActivityId"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Assign Activity
                    </button>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}