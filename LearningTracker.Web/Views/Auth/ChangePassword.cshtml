
@model LearningTracker.Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/change-password.css"
          asp-append-version="true" />
}

<div class="change-password-page">
    <div class="change-password-container">

        <!-- Page Header -->
        <div class="change-password-header">
            <span class="change-password-eyebrow">
                Account Security
            </span>

            <h2 class="change-password-title">
                Change Password
            </h2>

            <p class="change-password-description">
                Please enter your current password and choose a new one.
            </p>
        </div>

        <!-- Password Form -->
        <div class="change-password-card">
            <div class="change-password-card-body">

                <form asp-action="ChangePassword"
                      method="post"
                      class="change-password-form">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword"
                               class="form-label">
                        </label>

                        <input asp-for="CurrentPassword"
                               class="form-control"
                               autocomplete="current-password" />

                        <span asp-validation-for="CurrentPassword"
                              class="field-validation-error">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewPassword"
                               class="form-label">
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="NewPassword"
                              class="field-validation-error">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="field-validation-error">
                        </span>
                    </div>

                    <button type="submit"
                            class="change-password-submit">
                        Change Password
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
