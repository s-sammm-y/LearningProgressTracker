
@model LearningTracker.Web.ViewModels.CoordinatorRegistrationViewModel

@{
    ViewData["Title"] = "Create Coordinator";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/coordinator-create.css"
          asp-append-version="true" />
}

<div class="coordinator-create-page">
    <div class="coordinator-create-container">

        <div class="coordinator-create-card">
            <div class="coordinator-create-card-body">

                <div class="coordinator-create-header">
                    <span class="coordinator-create-eyebrow">
                        ADMINISTRATION
                    </span>

                    <h2 class="coordinator-create-title">
                        Create Coordinator Account
                    </h2>

                    <p class="coordinator-create-description">
                        Register a coordinator account to manage learning progress.
                    </p>
                </div>

                <form asp-controller="Coordinator"
                      asp-action="Register"
                      method="post"
                      class="coordinator-create-form">

                    <div class="coordinator-create-field">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="coordinator-create-field">
                        <label asp-for="RegistrationSecret"
                               class="form-label">
                            Registration Secret
                        </label>

                        <input asp-for="RegistrationSecret"
                               type="password"
                               class="form-control"
                               placeholder="Enter registration secret"
                               autocomplete="off" />

                        <span asp-validation-for="RegistrationSecret"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="coordinator-create-field">
                        <label asp-for="Password" class="form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Create your password"
                               autocomplete="new-password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="coordinator-create-field">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm your password"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="coordinator-create-submit">
                        Create Coordinator
                    </button>

                </form>

                <div class="coordinator-create-footer">
                    Already registered?
                    <a asp-controller="Auth"
                       asp-action="Login">
                        Sign in
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
