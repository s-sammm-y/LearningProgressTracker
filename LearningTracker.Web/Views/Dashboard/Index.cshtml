@model LearningTracker.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Coordinator Dashboard";
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2>Coordinator Dashboard</h2>
        <p class="text-muted">
            Overview of learning activities and candidate progress.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Learners</h6>
                    <h2 class="fw-bold">@Model.TotalLearners</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Activities</h6>
                    <h2 class="fw-bold">@Model.TotalActivities</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Assignments</h6>
                    <h2 class="fw-bold">@Model.TotalAssignments</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Completed Assignments</h6>
                    <h2 class="fw-bold text-success">
                        @Model.CompletedAssignments
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">
            <h5>Welcome, Coordinator!</h5>
            <p class="text-muted mb-0">
                Use the dashboard to manage learners, create activities,
                assign training and monitor progress.
            </p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h5 class="mb-3">Candidate Management</h5>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Learners"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-people"></i>
                View Candidates
            </a>

            <a asp-controller="Learners"
               asp-action="Create"
               class="btn btn-outline-primary">
                <i class="bi bi-person-plus"></i>
                Add Candidate
            </a>

        </div>
    </div>
</div>
<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h5 class="mb-3">Activity Management</h5>

        <a asp-controller="Activities"
           asp-action="Index"
           class="btn btn-primary">
            <i class="bi bi-journal-text"></i>
            View Activities
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
        <h5 class="mb-3">Assignment Management</h5>

        <p class="text-muted">
            Assign learning activities to candidates.
        </p>

        <a asp-controller="Assignments"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-clipboard-check"></i>
            Assign Activity
        </a>
    </div>
</div>
<div class="card shadow-sm mt-4">
    <div class="card-header">
        <h5 class="mb-0">Cohort Progress</h5>
    </div>

    <div class="card-body">
        @if (Model.CohortProgress.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Cohort</th>
                            <th>Candidates</th>
                            <th>Total Assignments</th>
                            <th>Completed</th>
                            <th>Progress</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cohort in Model.CohortProgress)
                        {
                            <tr>
                                <td>@cohort.CohortName</td>
                                <td>@cohort.TotalLearners</td>
                                <td>@cohort.TotalAssignments</td>
                                <td>@cohort.CompletedAssignments</td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @cohort.CompletionPercentage%"
                                             aria-valuenow="@cohort.CompletionPercentage"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                            @cohort.CompletionPercentage%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                No cohort progress available yet.
            </p>
        }
    </div>
</div>

</div>