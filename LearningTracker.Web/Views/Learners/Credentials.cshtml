
@{
    ViewData["Title"] = "Learner Credentials";

    var learnerName = TempData["LearnerName"]?.ToString();
    var learnerEmail = TempData["LearnerEmail"]?.ToString();
    var temporaryPassword = TempData["TemporaryPassword"]?.ToString();
}

<div class="learners-credential-page">
    <div class="container py-5">

        <div class="learners-credential-card">

            <!-- Success Header -->
            <div class="learners-credential-header">
                <h3>Candidate Created Successfully!</h3>

                <p>
                    The candidate account has been created.
                    Their login credentials are ready.
                </p>
            </div>

            <!-- Credential Content -->
            <div class="learners-credential-body">

                <!-- Important Notice -->
                <div class="learners-credential-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <div>
                        <strong>Important: Save these credentials</strong>
                        <p>
                            Copy the temporary password and share it securely
                            with the candidate. It will only be displayed once.
                        </p>
                    </div>
                </div>

                <!-- Candidate Name -->
                <div class="learners-credential-field">
                    <label>Candidate Name</label>

                    <div class="learners-credential-input-wrapper">
                        <i class="bi bi-person"></i>

                        <input class="learners-credential-input"
                               value="@learnerName"
                               readonly />
                    </div>
                </div>

                <!-- Email -->
                <div class="learners-credential-field">
                    <label>Email Address</label>

                    <div class="learners-credential-input-wrapper">
                        <i class="bi bi-envelope"></i>

                        <input class="learners-credential-input"
                               value="@learnerEmail"
                               readonly />
                    </div>
                </div>

                <!-- Temporary Password -->
                <div class="learners-credential-field">
                    <label>Temporary Password</label>

                    <div class="learners-password-wrapper">
                        <div class="learners-credential-input-wrapper">
                            <i class="bi bi-lock"></i>

                            <input id="temporaryPassword"
                                   class="learners-credential-input"
                                   value="@temporaryPassword"
                                   readonly />
                        </div>

                        <button type="button"
                                id="copyPasswordButton"
                                class="learners-copy-button">
                            <i class="bi bi-clipboard"></i>
                            Copy Password
                        </button>
                    </div>

                    <span id="copyPasswordMessage"
                          class="learners-copy-message"
                          role="status"
                          aria-live="polite">
                    </span>
                </div>

                <!-- Expiry Notice -->
                <div class="learners-credential-info">
                    <i class="bi bi-clock-history"></i>

                    <div>
                        <strong>Temporary Password Expiry</strong>
                        <p>
                            This password expires after 24 hours.
                            The candidate must change it during their first login.
                        </p>
                    </div>
                </div>

                <!-- Actions -->
                <div class="learners-credential-actions">

                    <a asp-controller="Learners"
                       asp-action="Create"
                       class="learners-credential-primary">
                        <i class="bi bi-person-plus"></i>
                        Create Another Candidate
                    </a>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="learners-credential-secondary">
                        <i class="bi bi-grid"></i>
                        Dashboard
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/learners-credential.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const copyButton = document.getElementById("copyPasswordButton");
            const passwordInput = document.getElementById("temporaryPassword");
            const message = document.getElementById("copyPasswordMessage");

            copyButton.addEventListener("click", async () => {
                const password = passwordInput.value;

                if (!password) {
                    message.textContent = "No password is available to copy.";
                    return;
                }

                try {
                    await navigator.clipboard.writeText(password);

                    message.textContent = "Temporary password copied successfully!";
                    copyButton.innerHTML =
                        '<i class="bi bi-check-lg"></i> Copied!';
                }
                catch {
                    passwordInput.focus();
                    passwordInput.select();

                    const copied = document.execCommand("copy");

                    message.textContent = copied
                        ? "Temporary password copied successfully!"
                        : "Unable to copy password. Please copy it manually.";

                    if (copied) {
                        copyButton.innerHTML =
                            '<i class="bi bi-check-lg"></i> Copied!';
                    }
                }
            });
        });
    </script>
}
