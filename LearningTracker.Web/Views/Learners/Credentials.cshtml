@{
    ViewData["Title"] = "Learner Credentials";

    var learnerName = TempData["LearnerName"]?.ToString();
    var learnerEmail = TempData["LearnerEmail"]?.ToString();
    var temporaryPassword = TempData["TemporaryPassword"]?.ToString();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <h2 class="text-success">Learner Created!</h2>
                        <p class="text-muted">
                            The learner account was created successfully.
                        </p>
                    </div>

                    <div class="alert alert-warning">
                        <strong>Important:</strong>
                        Copy these credentials and share them securely
                        with the learner. The temporary password will
                        only be displayed once.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Learner Name
                        </label>
                        <input class="form-control"
                               value="@learnerName"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Email
                        </label>
                        <input class="form-control"
                               value="@learnerEmail"
                               readonly />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Temporary Password
                        </label>

                        <div class="input-group">
                            <input id="temporaryPassword"
                                   class="form-control"
                                   value="@temporaryPassword"
                                   readonly />

                            <button class="btn btn-outline-primary"
                                    type="button"
                                    onclick="copyPassword()">
                                Copy
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        This temporary password expires after 24 hours.
                        The learner must change it during their first login.
                    </div>

                    <a asp-controller="Learners"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Another Learner
                    </a>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Dashboard
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyPassword() {
            const password = document.getElementById(
                "temporaryPassword"
            ).value;

            navigator.clipboard.writeText(password)
                .then(() => alert("Temporary password copied!"))
                .catch(() => alert("Unable to copy password."));
        }
    </script>
}