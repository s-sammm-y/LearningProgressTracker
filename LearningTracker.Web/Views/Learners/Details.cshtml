@model LearningTracker.Web.ViewModels.LearnerDetailsViewModel
@using LearningTracker.Models.Enums

@{
    ViewData["Title"] = "Candidate Details";
}

<div class="container mt-4">
    @if (TempData["ResetTemporaryPassword"] is string temporaryPassword)
    {
        <div class="alert alert-warning">
            <h5>New Temporary Password</h5>

            <p>
                Share this password privately with the candidate.
                It expires in 24 hours and must be changed on the next login.
            </p>

            <div class="d-flex gap-2 align-items-center">
                <code id="temporaryPassword">@temporaryPassword</code>

                <button type="button"
                        class="btn btn-sm btn-outline-dark"
                        onclick="navigator.clipboard.writeText(document.getElementById('temporaryPassword').innerText)">
                    Copy
                </button>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Candidate Details</h2>
            <p class="text-muted">View candidate information and training progress.</p>
        </div>

        <a asp-controller="Learners"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Candidates
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4>@Model.Learner.DisplayName</h4>

            <p class="mb-1">
                <strong>Email:</strong> @Model.Learner.Account.NormalizedEmail
            </p>

            <p class="mb-0">
                <strong>Cohort:</strong> @Model.Learner.Cohort
            </p>

            <form asp-controller="Learners"
                asp-action="ResetPassword"
                asp-route-id="@Model.Learner.Id"
                method="post"
                class="mt-3"
                onsubmit="return confirm('Are you sure you want to reset this candidate password?');">

                <button type="submit" class="btn btn-warning">
                    Reset Password
                </button>
            </form>
        </div>
    </div>

    <h4 class="mb-3">Assigned Training</h4>

    @if (!Model.Assignments.Any())
    {
        <div class="alert alert-info">
            No training assigned to this candidate yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Activity</th>
                            <th>Topic</th>
                            <th>Planned Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var assignment in Model.Assignments)
                        {
                            <tr>
                                <td>@assignment.Activity.Title</td>
                                <td>@assignment.Activity.Topic</td>
                                <td>@assignment.Activity.PlannedHours</td>
                                <td>
                                    @switch (assignment.Status)
                                    {
                                        case AssignmentStatus.NotStarted:
                                            <span class="badge bg-secondary">Not Started</span>
                                            break;

                                        case AssignmentStatus.InProgress:
                                            <span class="badge bg-primary">In Progress</span>
                                            break;

                                        case AssignmentStatus.Completed:
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

</div>