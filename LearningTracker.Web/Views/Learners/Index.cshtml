@model List<LearningTracker.Models.Entities.Learner>

@{
    ViewData["Title"] = "Candidates";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Candidates</h2>
            <p class="text-muted mb-0">
                Manage all registered candidates.
            </p>
        </div>

        <a asp-controller="Learners"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus"></i>
            Add Candidate
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No candidates have been registered yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Cohort</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var learner in Model)
                        {
                            <tr>
                                <td>@learner.DisplayName</td>
                                <td>@learner.Account.NormalizedEmail</td>
                                <td>@learner.Cohort</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>