
@model List<LearningTracker.Models.Entities.Learner>

@{
    ViewData["Title"] = "Candidates";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/learners.css"
          asp-append-version="true" />
}

<div class="learners-page">
    <div class="container py-5">

        <!-- Page Header -->
        <div class="learners-header">
            <div>
                <span class="learners-eyebrow">People Management</span>

                <h1 class="learners-title">Candidates</h1>

                <p class="learners-description">
                    Manage candidate accounts, view their details,
                    and keep track of their assigned learning journey.
                </p>
            </div>

            <a asp-controller="Learners"
               asp-action="Create"
               class="learners-primary-button">
                <i class="bi bi-person-plus"></i>
                Add Candidate
            </a>
        </div>

        <!-- Candidate Content -->
        @if (!Model.Any())
        {
            <div class="learners-empty-state">
                <div class="learners-empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h3>No candidates yet</h3>

                <p>
                    You haven't registered any candidates.
                    Start by creating your first candidate account.
                </p>

                <a asp-controller="Learners"
                   asp-action="Create"
                   class="learners-primary-button">
                    <i class="bi bi-plus-lg"></i>
                    Add First Candidate
                </a>
            </div>
        }
        else
        {
            <div class="learners-table-card">

                <!-- Table Header -->
                <div class="learners-table-heading">

                    <div>
                        <h4>Registered Candidates</h4>
                        <p>View and manage your candidate accounts.</p>
                    </div>

                    <span class="learners-count" id="candidateCount">
                        @Model.Count @(Model.Count == 1 ? "Candidate" : "Candidates")
                    </span>

                </div>

                <!-- Search -->
                <div class="learners-search-container">

                    <div class="learners-search-box">
                        <i class="bi bi-search"></i>

                        <input type="search"
                               id="candidateSearch"
                               class="learners-search-input"
                               placeholder="Search by name, email or cohort..."
                               autocomplete="off"
                               aria-label="Search candidates" />

                        <button type="button"
                                id="clearCandidateSearch"
                                class="learners-search-clear"
                                aria-label="Clear search"
                                hidden>
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>

                </div>

                <!-- Candidate Table -->
                <div class="table-responsive learners-table-scroll">
                    <table class="table learners-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Candidate</th>
                                <th>Email Address</th>
                                <th>Cohort</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="candidateTableBody">

                            @foreach (var learner in Model)
                            {
                                <tr class="candidate-row"
                                    data-search="@($"{learner.DisplayName} {learner.Account.NormalizedEmail} {learner.Cohort}")">

                                    <td>
                                        <div class="candidate-name">
                                            <div class="candidate-avatar">
                                                @learner.DisplayName.Substring(0, 1).ToUpper()
                                            </div>

                                            <span>@learner.DisplayName</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="candidate-email">
                                            @learner.Account.NormalizedEmail
                                        </span>
                                    </td>

                                    <td>
                                        <span class="cohort-badge">
                                            @learner.Cohort
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Learners"
                                           asp-action="Details"
                                           asp-route-id="@learner.Id"
                                           class="learners-view-button">
                                            View Details
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </td>

                                </tr>
                            }

                            <!-- No Search Results -->
                            <tr id="noSearchResults" hidden>
                                <td colspan="4">
                                    <div class="learners-search-empty">
                                        <i class="bi bi-search"></i>
                                        <h5>No matching candidates</h5>
                                        <p>
                                            Try searching with a different name,
                                            email address or cohort.
                                        </p>
                                    </div>
                                </td>
                            </tr>

                        </tbody>

                    </table>
                </div>
            </div>
        }

        <!-- Back Navigation -->
        <div class="learners-back">
            <a asp-controller="Dashboard"
               asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Back to Dashboard
            </a>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/js/learners.js"
            asp-append-version="true"></script>
}
